        "bbox": [
          147.0,
          267.0,
          316.0,
          296.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-4",
        "page": 1,
        "text": "Toshkent shahri",
        "bbox": [
          561.0,
          273.0,
          713.0,
          302.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-5",
        "page": 1,
        "text": "No 145",
        "bbox": [
          1060.0,
          281.0,
          1127.0,
          307.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-6",
        "page": 1,
        "text": "Yuridik xizmatlarni koʻrsatishda sunʼiy intellekt texnologiyalaridan foydalanish chora-tadbirlari toʻgʻrisida",
        "bbox": [
          164.0,
          334.0,
          1105.0,
          413.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-7",
        "page": 1,
        "text": "Yuridik xizmatlar sifati va tezligini oshirish, ish jarayonlarini avtomatlashtirish maqsadida Komissiya qaror qiladi:",
        "bbox": [
          156.0,
          419.0,
          1112.0,
          494.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-8",
        "page": 1,
        "text": "1. Yuridik xizmatlarda sun'iy intellekt texnologiyalarini joriy etish boʻyicha quyidagi topshiriqlar belgilansin:",
        "bbox": [
          154.0,
          495.0,
          1112.0,
          571.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c0",
        "page": 1,
        "text": "1",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c1",
        "page": 1,
        "text": "Murojaatlarni avtomatik tasniflash modulini joriy etish",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c2",
        "page": 1,
        "text": "Axborot texnologiyalari boshqarmasi",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c3",
        "page": 1,
        "text": "2026-yil 1-may",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c0",
        "page": 1,
        "text": "2",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c1",
        "page": 1,
        "text": "Elektron yuridik maslahat chatbotini ishga tushirish",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c2",
        "page": 1,
        "text": "Axborot texnologiyalari boshqarmasi, Yuridik xizmat koʻrsatish boshqarmasi",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c3",
        "page": 1,
        "text": "2026-yil 15-iyun",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c0",
        "page": 1,
        "text": "3",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c1",
        "page": 1,
        "text": "Topshiriqlarni avtomatik taqsimlash tizimini sinovdan oʻtkazish",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c2",
        "page": 1,
        "text": "Ish yuritish (devonxona) boʻlimi",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c3",
        "page": 1,
        "text": "tizim tayyor boʻlgandan soʻng 2 oy ichida",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c0",
        "page": 1,
        "text": "4",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c1",
        "page": 1,
        "text": "Xodimlar uchun oʻquv seminarlarini tashkil etish",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c2",
        "page": 1,
        "text": "Kadrlar boshqarmasi",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c3",
        "page": 1,
        "text": "har chorakda",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r5-c0",
        "page": 1,
        "text": "5",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r5-c1",
        "page": 1,
        "text": "Maʼlumotlar xavfsizligi talablariga muvofiqlikni taʼminlash",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r5-c2",
        "page": 1,
        "text": "Axborot xavfsizligi boʻlinmasi",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r5-c3",
        "page": 1,
        "text": "2026-yil 20-aprel",
        "bbox": [
          140.0,
          571.0,
          1121.0,
          1022.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-10",
        "page": 1,
        "text": "2. Axborot texnologiyalari boshqarmasi yuqoridagi topshiriqlar ijrosi toʻgʻrisida har chorak yakunidan keyingi oyning 10-sanasiga qadar Komissiyaga axborot kiritsin.",
        "bbox": [
          145.0,
          1031.0,
          1104.0,
          1110.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-11",
        "page": 1,
        "text": "3. Mazkur qaror ijrosini nazorat qilish Komissiya kotibiyati zimmasiga yuklansin.",
        "bbox": [
          217.0,
          1107.0,
          1086.0,
          1153.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-12",
        "page": 1,
        "text": "Komissiya raisi",
        "bbox": [
          132.0,
          1208.0,
          314.0,
          1240.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-13",
        "page": 1,
        "text": "O. Saidov",
        "bbox": [
          997.0,
          1220.0,
          1113.0,
          1252.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-14",
        "page": 1,
        "text": "Test uchun example — AI tizimini sinash uchun tuzilgan. Tashkilot nomlari, raqamlar, manzillar va shaxslar shartli.",
        "bbox": [
          186.0,
          1619.0,
          991.0,
          1654.0
        ],
        "parent_id": null
      }
    ],
