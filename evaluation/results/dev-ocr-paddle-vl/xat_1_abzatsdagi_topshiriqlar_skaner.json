        "id": "p1-vl-1",
        "page": 1,
        "text": "RAQAMLI HUQUQIY XIZMATLAR AGENTLIGI 100011, Toshkent shahri, Yangi hayot koʻchasi, 12-uy. Tel.: +998 (71) 000-12-30. E-mail: info@rhxa.example",
        "bbox": [
          222.0,
          129.0,
