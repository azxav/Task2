        "text": "5",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r5-c1",
        "page": 1,
        "text": "Tajriba-sinov natijalarini baholash va aniqlangan kamchiliklar boʻyicha takliflar kiritish",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r5-c2",
        "page": 1,
