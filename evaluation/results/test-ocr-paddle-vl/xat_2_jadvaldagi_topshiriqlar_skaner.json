      },
      {
        "id": "p1-vl-table1-r6-c0",
        "page": 1,
        "text": "6",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r6-c1",
        "page": 1,
        "text": "Bajarilgan ishlar holati toʻgʻrisida qisqacha maʼlumot taqdim etish",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r6-c2",
        "page": 1,
        "text": "Loyihaga koordinatori",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r6-c3",
        "page": 1,
        "text": "har haftaning juma kuni",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-9",
        "page": 1,
        "text": "Bajarilgan ishlar boʻyicha umumlashtirilgan maʼlumot loyiha koordinatori orqali Korxonaning Raqamlı loyihalar boshqarmasiga taqdim etilsin.",
