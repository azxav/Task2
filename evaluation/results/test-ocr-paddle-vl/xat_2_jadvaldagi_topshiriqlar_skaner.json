      {
        "id": "p1-vl-1",
        "page": 1,
        "text": "“YANGI AVLOD RAQAMLI YECHIMLAR” DAVLAT UNITAR KORXONASI",
        "bbox": [
          344.0,
          128.0,
          919.0,
          194.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-2",
        "page": 1,
        "text": "100084, Toshkent shahri, Ilm-fan koʻchasi, 7-uy. Tel.: +998 (71) 000-45-60. E-mail: devonxona@yaryve.example",
        "bbox": [
          218.0,
          199.0,
          1048.0,
          227.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-3",
        "page": 1,
        "text": "11.09.2026 No 15/2-784",
        "bbox": [
          143.0,
          255.0,
          364.0,
          284.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-5",
        "page": 1,
        "text": "Adliya organlari va muassasalarda axborot texnologiyalarini rivojlantirish markaziga",
        "bbox": [
          609.0,
          258.0,
          1114.0,
          327.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-4",
        "page": 1,
        "text": "“_____” _____ dagi _____-son xatga",
        "bbox": [
          144.0,
          288.0,
          525.0,
          315.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-6",
        "page": 1,
        "text": "Sun'iy intellekt modullarini tajriba-sinovdan oʻtkazish toʻgʻrisida",
        "bbox": [
          152.0,
          351.0,
          815.0,
          384.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-7",
        "page": 1,
        "text": "Korxona va Markaz oʻrtasida 2026-yil 2-sentabrda imzolangan hamkorlik memorandumi doirasida sunʻiy intellekt texnologiyalarini amaliy jarayonlarda sinovdan oʻtkazish maqsadida quyidagi jadvalda koʻrsatilgan topshiriqlarning belgilganan muddatlarda bajarilishini soʻraymiz.",
        "bbox": [
          151.0,
          400.0,
          1111.0,
          537.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c0",
        "page": 1,
        "text": "1",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c1",
        "page": 1,
        "text": "Murojaatlar portalidagi mavjud klassifikatorlarni inventarizatsiya qilish va ularni takomillashtirish boʻyicha taklif tayyorlash",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c2",
        "page": 1,
        "text": "Tizim tahlili boʻlimi",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r1-c3",
        "page": 1,
        "text": "18.09.2026",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c0",
        "page": 1,
        "text": "2",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c1",
        "page": 1,
        "text": "Hujjatlardan topshiriq, muddat va ijrochi haqidagi maʼlumotlarni avtomatik ajratish boʻyicha prototip ishlab chiqish",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c2",
        "page": 1,
        "text": "Sun'iy intellekt laboratoriyasi",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r2-c3",
        "page": 1,
        "text": "30.09.2026",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c0",
        "page": 1,
        "text": "3",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c1",
        "page": 1,
        "text": "Topshiriqlarni tarkibiy boʻlinmalarga yoʻnaltirisch uchun vakolatlar va tashkiliy tuzilma maʼlumotlarini shakllantirish",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c2",
        "page": 1,
        "text": "Biznes-tahlil boʻlimi, Kadrlar boʻlimi",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r3-c3",
        "page": 1,
        "text": "2026-yil 5-oktabr",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c0",
        "page": 1,
        "text": "4",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c1",
        "page": 1,
        "text": "AI modullarining mavjud axborot tizimlari bilan integratsiyasi boʻyicha texnik talablarni tayyorlash",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c2",
        "page": 1,
        "text": "Integratsiya boʻlimi",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r4-c3",
        "page": 1,
        "text": "prototip tayyor boʻlgandan soʻng 15 kun ichida",
        "bbox": [
          140.0,
          547.0,
          1117.0,
          1144.0
        ],
        "parent_id": null
      },
      {
        "id": "p1-vl-table1-r5-c0",
